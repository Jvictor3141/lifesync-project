# Copie este arquivo para .env e preencha com as suas credenciais do Firebase.
# NUNCA commite o arquivo .env — ele já está no .gitignore.
# Obtenha os valores em: https://console.firebase.google.com → Configurações do projeto → Seus aplicativos

VITE_FIREBASE_API_KEY=AIzaSy_substitua_pela_sua_chave
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
